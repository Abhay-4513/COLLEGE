
# Import libraries
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

from sklearn.datasets import make_moons
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.pipeline import make_pipeline
from sklearn.svm import SVC
from sklearn.metrics import (
    accuracy_score,
    precision_score,
    recall_score,
    f1_score,
    confusion_matrix
)

# Configuration
RANDOM_STATE = 42
sns.set_theme(style="whitegrid")

# 1. Generate the binary dataset
X, y = make_moons(
    n_samples=600,
    noise=0.25,
    random_state=RANDOM_STATE
)

# 2. Split into training and testing sets
X_train, X_test, y_train, y_test = train_test_split(
    X, y,
    test_size=0.25,
    random_state=RANDOM_STATE,
    stratify=y
)

# 3. Visualize the dataset
plt.figure(figsize=(6, 5))
plt.scatter(
    X[:, 0], X[:, 1],
    c=y, cmap="coolwarm",
    s=22, edgecolor="k", linewidth=0.25
)
plt.title("Make Moons Binary Dataset")
plt.xlabel("Feature 1")
plt.ylabel("Feature 2")
plt.show()

# 4. Define SVM models with different kernels
models = {
    "Linear": SVC(kernel="linear", C=1.0),
    "Polynomial": SVC(
        kernel="poly", degree=3, C=1.0, gamma="scale"
    ),
    "RBF": SVC(kernel="rbf", C=1.0, gamma="scale")
}

# 5. Train models and evaluate performance
trained_models = {}
results = []

for name, svm in models.items():
    model = make_pipeline(StandardScaler(), svm)

    model.fit(X_train, y_train)
    y_pred = model.predict(X_test)

    trained_models[name] = model

    results.append({
        "Kernel": name,
        "Accuracy": accuracy_score(y_test, y_pred),
        "Precision": precision_score(
            y_test, y_pred, zero_division=0
        ),
        "Recall": recall_score(
            y_test, y_pred, zero_division=0
        ),
        "F1-score": f1_score(
            y_test, y_pred, zero_division=0
        )
    })

# 6. Display comparison table
results_df = pd.DataFrame(results)
results_df = results_df.sort_values(
    by="F1-score", ascending=False
).reset_index(drop=True)

print("\nSVM Kernel Comparison")
print(results_df.round(4).to_string(index=False))

# 7. Identify the best kernel based on test F1-score
best_kernel = results_df.iloc[0]["Kernel"]
best_f1 = results_df.iloc[0]["F1-score"]

print(f"\nBest kernel: {best_kernel}")
print(f"Best test F1-score: {best_f1:.4f}")

# 8. Plot decision boundaries for all three models
fig, axes = plt.subplots(1, 3, figsize=(16, 4.8))

for ax, (name, model) in zip(axes, trained_models.items()):
    scaler = model.named_steps["standardscaler"]
    svm = model.named_steps["svc"]

    # Transform data to standardized coordinates
    X_train_scaled = scaler.transform(X_train)

    # Create mesh grid
    pad = 0.6
    x_min = X_train_scaled[:, 0].min() - pad
    x_max = X_train_scaled[:, 0].max() + pad
    y_min = X_train_scaled[:, 1].min() - pad
    y_max = X_train_scaled[:, 1].max() + pad

    xx, yy = np.meshgrid(
        np.linspace(x_min, x_max, 300),
        np.linspace(y_min, y_max, 300)
    )

    grid = np.c_[xx.ravel(), yy.ravel()]
    Z = svm.predict(grid).reshape(xx.shape)

    # Plot decision regions
    ax.contourf(
        xx, yy, Z,
        alpha=0.25,
        cmap="coolwarm"
    )

    # Plot training data
    ax.scatter(
        X_train_scaled[:, 0],
        X_train_scaled[:, 1],
        c=y_train,
        cmap="coolwarm",
        s=20,
        edgecolor="k",
        linewidth=0.25
    )

    # Highlight support vectors
    ax.scatter(
        svm.support_vectors_[:, 0],
        svm.support_vectors_[:, 1],
        s=65,
        facecolors="none",
        edgecolors="black",
        linewidths=1,
        label="Support vectors"
    )

    f1_value = results_df.loc[
        results_df["Kernel"] == name, "F1-score"
    ].iloc[0]

    ax.set_title(f"{name} SVM (F1 = {f1_value:.3f})")
    ax.set_xlabel("Standardized Feature 1")
    ax.set_ylabel("Standardized Feature 2")
    ax.legend(fontsize=8)

plt.suptitle("Decision Boundary Comparison of SVM Kernels")
plt.tight_layout()
plt.show()

# 9. Plot test F1-score comparison
plt.figure(figsize=(7, 4))
sns.barplot(
    data=results_df,
    x="Kernel",
    y="F1-score",
    hue="Kernel",
    palette="viridis",
    legend=False
)
plt.ylim(0, 1)
plt.title("Test F1-score by SVM Kernel")
plt.ylabel("F1-score")
plt.xlabel("Kernel")
plt.show()

# 10. Confusion matrix for the best-performing model
best_model = trained_models[best_kernel]
best_predictions = best_model.predict(X_test)

cm = confusion_matrix(y_test, best_predictions)

plt.figure(figsize=(5, 4))
sns.heatmap(
    cm,
    annot=True,
    fmt="d",
    cmap="Blues",
    cbar=False,
    xticklabels=[0, 1],
    yticklabels=[0, 1]
)
plt.title(f"Confusion Matrix - Best Kernel: {best_kernel}")
plt.xlabel("Predicted Label")
plt.ylabel("Actual Label")
plt.show()
