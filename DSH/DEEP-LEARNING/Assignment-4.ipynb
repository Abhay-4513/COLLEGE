"""Binary classification using TensorFlow/Keras and Sigmoid.

Dataset: Breast Cancer Wisconsin (Diagnostic), loaded from scikit-learn.
Run: python sigmoid_binary_classification.py
"""

import time
import numpy as np
import matplotlib.pyplot as plt
import tensorflow as tf
from sklearn.datasets import load_breast_cancer
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler

# Make the experiment as repeatable as possible.
np.random.seed(42)
tf.keras.utils.set_random_seed(42)

# 1. Load a binary classification dataset (0 = malignant, 1 = benign).
dataset = load_breast_cancer()
X = dataset.data.astype("float32")
y = dataset.target.astype("float32")

# 2. Create train, validation, and test sets: 64%, 16%, and 20%.
X_train_full, X_test, y_train_full, y_test = train_test_split(
    X, y, test_size=0.20, random_state=42, stratify=y
)
X_train, X_val, y_train, y_val = train_test_split(
    X_train_full, y_train_full, test_size=0.20,
    random_state=42, stratify=y_train_full
)

# 3. Standardize features. Fit only on training data to avoid data leakage.
scaler = StandardScaler()
X_train = scaler.fit_transform(X_train).astype("float32")
X_val = scaler.transform(X_val).astype("float32")
X_test = scaler.transform(X_test).astype("float32")

# 4. Construct the same three-hidden-layer network for this activation.
model = tf.keras.Sequential(name="sigmoid_classifier")
model.add(tf.keras.layers.Input(shape=(X_train.shape[1],)))
model.add(tf.keras.layers.Dense(64, activation="sigmoid"))
model.add(tf.keras.layers.Dense(32, activation="sigmoid"))
model.add(tf.keras.layers.Dense(16, activation="sigmoid"))
model.add(tf.keras.layers.Dense(1, activation="sigmoid"))

# 5. Compile for binary classification.
model.compile(
    optimizer=tf.keras.optimizers.Adam(learning_rate=0.001),
    loss="binary_crossentropy",
    metrics=["accuracy"],
)
model.summary()

# Stop if validation loss has not improved for 10 epochs and restore best weights.
early_stopping = tf.keras.callbacks.EarlyStopping(
    monitor="val_loss", patience=10, restore_best_weights=True, verbose=1
)

# 6. Train the model and measure wall-clock training time.
start_time = time.perf_counter()
history = model.fit(
    X_train, y_train,
    validation_data=(X_val, y_val),
    epochs=100,
    batch_size=32,
    callbacks=[early_stopping],
    verbose=1,
)
training_seconds = time.perf_counter() - start_time

# Epoch with the lowest validation loss is our convergence-speed proxy.
best_epoch = int(np.argmin(history.history["val_loss"]) + 1)
best_val_loss = float(np.min(history.history["val_loss"]))

test_loss, test_accuracy = model.evaluate(X_test, y_test, verbose=0)

print("\n========== EXPERIMENT RESULTS ==========")
print("Activation function : Sigmoid")
print(f"Best validation epoch: {best_epoch} / {len(history.history['loss'])}")
print(f"Best validation loss : {best_val_loss:.4f}")
print(f"Test loss            : {test_loss:.4f}")
print(f"Test accuracy        : {test_accuracy * 100:.2f}%")
print(f"Training time        : {training_seconds:.3f} seconds")

# 7. Save loss curves to visually inspect convergence.
plt.figure(figsize=(8, 5))
plt.plot(history.history["loss"], label="Training loss")
plt.plot(history.history["val_loss"], label="Validation loss")
plt.axvline(best_epoch - 1, linestyle="--", label=f"Best epoch = {best_epoch}")
plt.title("Sigmoid activation — Loss vs Epoch")
plt.xlabel("Epoch")
plt.ylabel("Binary cross-entropy loss")
plt.legend()
plt.grid(True, alpha=0.3)
plt.tight_layout()
plot_file = "loss_curve_sigmoid.png"
plt.savefig(plot_file, dpi=150)
print(f"Loss curve saved to: {plot_file}")
plt.show()
